<UserControl x:Class="Editor.View.Inspector.MaterialInpector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Editor.View.Inspector"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinWidth" Value="30"/>
        </Style>
        <Style x:Key="StackPanelListBoxStyle1" TargetType="ListBox">
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <!--<Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Grid Grid.IsSharedSizeScope="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" SharedSizeGroup="PropertyName"/>
                                <ColumnDefinition Width="*"   MinWidth="30" SharedSizeGroup="Place"/>
                                <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValueName_1"/>
                                <ColumnDefinition  Width="auto" SharedSizeGroup="PropertyValue_1"/>
                                <ColumnDefinition  Width="auto" SharedSizeGroup="PropertyValueName_2"/>
                                <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValue_2"/>
                                <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValueName_3"/>
                                <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValue_3"/>
                                <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValueName_4"/>
                                <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValue_4"/>
                            </Grid.ColumnDefinitions>
                          <ItemsPresenter />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>-->
        </Style>


        <Style x:Key="TB_MaterialHeader" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderThickness="0.5" BorderBrush="Black" Background="{TemplateBinding Background}">
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" MinWidth="10" MaxWidth="15"/>
                                    <ColumnDefinition Width="auto" MinWidth="30" MaxWidth="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!--<ToggleButton Content="下" IsChecked="False" Grid.Row="1" VerticalAlignment="Bottom"/>-->
                                <Image Source="/Resource/Image/Icon/Material.png" MaxHeight="30" Grid.Row="0"  Grid.RowSpan="2" Grid.Column="1"/>
                                <Label  Grid.Column="2" Grid.Row="0" Content="{Binding MaterialName}" ContentStringFormat=" {0} '(Material)'"/>
                                <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch">
                                    <Label Content="Shader:" />
                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Shaders}" DisplayMemberPath="ShaderName" SelectedIndex="{Binding SelectedShaderIndex}" MinWidth="100">

                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="MaterialFloatPorpertyTemplate">
            <Grid  >
                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" SharedSizeGroup="PropertyName"/>
                <ColumnDefinition Width="*" SharedSizeGroup="Place"/>
                <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValueName_1"/>
                    <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValue_1"/>
                    <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValueName_2"/>
                    <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValue_2"/>
                    <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValueName_3"/>
                    <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValue_3"/>
                    <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValueName_4"/>
                    <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValue_4"/>
            </Grid.ColumnDefinitions>
            <Label Content="{Binding Title}" Grid.Column="0"/>
            <TextBox Text="{Binding PropertyValue,Converter={StaticResource StringToFloat},UpdateSourceTrigger=LostFocus}"   Grid.Column="9" MinWidth="20"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MaterialFloat3PorpertyTemplate">
            <Grid  >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" SharedSizeGroup="PropertyName"/>
                    <ColumnDefinition Width="*" SharedSizeGroup="Place"/>
                    <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValueName_1"/>
                    <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValue_1"/>
                    <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValueName_2"/>
                    <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValue_2"/>
                    <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValueName_3"/>
                    <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValue_3"/>
                    <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValueName_4"/>
                    <ColumnDefinition Width="auto" SharedSizeGroup="PropertyValue_4"/>
                </Grid.ColumnDefinitions>
                <Label Content="{Binding Title}" Grid.Column="0"/>

                <Label Content="X:"  Grid.Column="4"/>
                <TextBox Text="{Binding PropertyValue.X}" Grid.Column="5" MinWidth="20"/>
                <Label Content="Y:"  Grid.Column="6"/>
                <TextBox Text="{Binding PropertyValue.Y}"  Grid.Column="7" MinWidth="20"/>
                <Label Content="Z:"  Grid.Column="8"/>
                <TextBox Text="{Binding PropertyValue.Z}"  Grid.Column="9" MinWidth="20"/>
               
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MaterialFloat4PorpertyTemplate">
            <Grid   >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" SharedSizeGroup="PropertyName"/>
                    <ColumnDefinition Width="*" SharedSizeGroup="Place"/>
                    <ColumnDefinition SharedSizeGroup="PropertyValueName_1"/>
                    <ColumnDefinition SharedSizeGroup="PropertyValue_1"/>
                    <ColumnDefinition SharedSizeGroup="PropertyValueName_2"/>
                    <ColumnDefinition SharedSizeGroup="PropertyValue_2"/>
                    <ColumnDefinition SharedSizeGroup="PropertyValueName_3"/>
                    <ColumnDefinition SharedSizeGroup="PropertyValue_3"/>
                    <ColumnDefinition SharedSizeGroup="PropertyValueName_4"/>
                    <ColumnDefinition SharedSizeGroup="PropertyValue_4"/>
                </Grid.ColumnDefinitions>
                <Label Content="{Binding Title}" Grid.Column="0"/>

                   <Label Content="X" Grid.Column="2"/>
                   <TextBox Text="{Binding PropertyValue.X}"  Grid.Column="3" />
                    <Label Content="Y:" Grid.Column="4"/>
                    <TextBox Text="{Binding PropertyValue.Y}"  Grid.Column="5" />
                    <Label Content="Z:" Grid.Column="6"/>
                    <TextBox Text="{Binding PropertyValue.Z}"  Grid.Column="7" />
                    <Label Content="W:" Grid.Column="8"/>
                    <TextBox Text="{Binding PropertyValue.W}"  Grid.Column="9" />
               
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MaterialTexturePropertyTemplpate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="{Binding Title}" Grid.Column="0"/>
                <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0.5">
                    <local:MaterialTexturePropertyView Height="80" Width="80" DataContext="{Binding PropertyValue}"/>
                </Border>
            </Grid>
        </DataTemplate>
        <local:MaterialPropertyItemTemplateSelector x:Key="MaterialPropertyTemplate"
                                              MaterialFloatPorpertyTemplate="{StaticResource MaterialFloatPorpertyTemplate}"
                                             MaterialFloat3PropertyTemplate="{StaticResource MaterialFloat3PorpertyTemplate}"
                                             MaterialFloat4PropertyTemplate="{StaticResource MaterialFloat4PorpertyTemplate}"
                                             MaterialTexturePropertyTemplate="{StaticResource MaterialTexturePropertyTemplpate}">

        </local:MaterialPropertyItemTemplateSelector>
        <Style x:Key="MaterialContentControlStyle" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="Transparent">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border BorderBrush="Black" BorderThickness="1" />
                                <ToggleButton Background="Transparent" IsChecked="True" Grid.Row="1" Style="{StaticResource TB_MaterialHeader}" HorizontalAlignment="Stretch" x:Name="PART_TB"/>
                                <Grid Grid.Row="2" x:Name="PART_GridProeprties">
                                    <ListBox Style="{StaticResource StackPanelListBoxStyle1}" ItemsSource="{Binding MaterialProperties}" ItemTemplateSelector="{StaticResource MaterialPropertyTemplate}">

                                    </ListBox>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding ElementName=PART_TB,Path=IsChecked}" Value="False">
                                <Setter Property="Visibility" TargetName="PART_GridProeprties" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=PART_TB,Path=IsChecked}" Value="True">
                                <Setter Property="Visibility" TargetName="PART_GridProeprties" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <ContentControl Style="{StaticResource MaterialContentControlStyle}" DataContext="{Binding Material}"/>
    </Grid>
</UserControl>
