<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="clr-namespace:DirectX12PioneerEngine.UI.Helpers"
                    xmlns:rs="clr-namespace:DirectX12PioneerEngine.UI.Resources">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DirectX12PioneerEngine.UI;component/Styles/ComboBoxItemStyle.xaml"/>
        <ResourceDictionary Source="/DirectX12PioneerEngine.UI;component/Templates/ComboBoxTemplate.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="ComboBox">
        <Setter Property="i:ElementStateManager.Background" Value="{DynamicResource ComboBox.BackgroundBrush}"/>
        <Setter Property="i:ElementStateManager.BorderBrush" Value="{DynamicResource ComboBox.BorderBrush }"/>
        <Setter Property="i:ElementStateManager.BorderThickness" Value="0.5"/>
        <Setter Property="i:ElementStateManager.BorderCornerRadius" Value="3"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource {x:Static rs:StyleKeys.ComboBoxItemStyle}}"/>
        <Setter Property="Template" Value="{StaticResource {x:Static rs:TemplateKeys.ComboBoxTemplate}}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="i:ElementStateManager.Background" Value="{DynamicResource ComoBox.Background.MouseOverBrush}"/>
                <Setter Property="i:ElementStateManager.BorderBrush" Value="{DynamicResource ComboBox.Border.MouseOverBrush}"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="i:ElementStateManager.Background" Value="{DynamicResource ComboBox.Background.Pressed}"/>
                <Setter Property="i:ElementStateManager.BorderBrush" Value="{DynamicResource ComboBox.Border.Pressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>