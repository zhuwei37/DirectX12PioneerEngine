<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="clr-namespace:DirectX12PioneerEngine.UI.Helpers"
                    xmlns:rs="clr-namespace:DirectX12PioneerEngine.UI.Resources">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DirectX12PioneerEngine.UI;component/Templates/CheckBoxTemplate.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="CheckBox">

        <Setter Property="i:ElementStateManager.Background" Value="{DynamicResource CheckBox.BackgroundBrush}"/>
        <Setter Property="i:ElementStateManager.BorderBrush" Value="{DynamicResource CheckBox.BorderBrush}"/>
        <Setter Property="i:ElementStateManager.BorderCornerRadius" Value="3"/>
        <Setter Property="i:ElementStateManager.BorderThickness" Value="1"/>


        <Setter Property="Template" Value="{StaticResource { x:Static rs:TemplateKeys.CheckBoxTemplate}}"></Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="i:ElementStateManager.Background" Value="{DynamicResource CheckBox.Background.MouseOverBrush}"/>
                <Setter Property="i:ElementStateManager.BorderBrush" Value="{DynamicResource CheckBox.Border.MouseOverBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="i:ElementStateManager.Background" Value="{DynamicResource CheckBox.Background.CheckedBrush}"/>
                <Setter Property="i:ElementStateManager.BorderBrush" Value="{DynamicResource CheckBox.Border.CheckedBrush }"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>