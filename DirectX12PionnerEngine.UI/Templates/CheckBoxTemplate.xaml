<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rs="clr-namespace:DirectX12PioneerEngine.UI.Resources"
                    xmlns:i="clr-namespace:DirectX12PioneerEngine.UI.Helpers"
                    >
    <ControlTemplate x:Key="{x:Static rs:TemplateKeys.CheckBoxTemplate }" TargetType="CheckBox">
        <Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Bor"
                        Height="{Binding RelativeSource={RelativeSource TemplatedParent},Path=(i:CheckBoxHelper.BoxHeight),Mode=OneWay}"
                        Width="{Binding RelativeSource={RelativeSource TemplatedParent},Path=(i:CheckBoxHelper.BoxWidth),Mode=OneWay}"
                        BorderBrush="{Binding RelativeSource={RelativeSource TemplatedParent},Path=(i:ElementStateManager.BorderBrush),Mode=OneWay}"
                        BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent},Path=(i:ElementStateManager.BorderThickness),Mode=OneWay}"
                        Background="{Binding RelativeSource={RelativeSource TemplatedParent},Path=(i:ElementStateManager.Background),Mode=OneWay}"
                        CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent},Path=(i:ElementStateManager.BorderCornerRadius),Mode=OneWay}"
                        >
                   
                </Border>
                <Border x:Name="InnerBor" Visibility="Collapsed" 
                        Height="{Binding RelativeSource={RelativeSource TemplatedParent},Path=(i:CheckBoxHelper.BoxHeight),Mode=OneWay}"
                        Width="{Binding RelativeSource={RelativeSource TemplatedParent},Path=(i:CheckBoxHelper.BoxWidth),Mode=OneWay}"
                        Margin="{TemplateBinding Padding}" >
                    <Path  Fill="{TemplateBinding Foreground}"   StrokeDashCap="Round" StrokeThickness="0.1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path.Data>
                            <MultiBinding Converter="{x:Static rs:Converters.CheckBoxPathConverter}">
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border}" Mode="OneWay" />
                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource  AncestorType=Border}" Mode="OneWay"/>
                            </MultiBinding>
                        </Path.Data>
                    </Path>

                </Border>
                <ContentPresenter x:Name="CcContent"
                                  Grid.Column="1"
                                  VerticalAlignment="{Binding RelativeSource={RelativeSource TemplatedParent},Path=VerticalContentAlignment}"
                                  HorizontalAlignment="{Binding RelativeSource={RelativeSource TemplatedParent},Path=HorizontalContentAlignment,Mode=OneWay}"
                                  TextBlock.Foreground="{Binding RelativeSource={RelativeSource TemplatedParent},Path=(i:ElementStateManager.Foreground),Mode=OneWay}"
                                  Margin="{TemplateBinding Padding}"
                                  />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent},Path=(i:CheckBoxHelper.ContentPlacement),Mode=OneWay}" 
                         Value="Right">
                <Setter Property="Grid.Column" Value="2" TargetName="Bor"/>
                <Setter Property="Grid.Column" Value="2" TargetName="InnerBor"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent},Path=(i:CheckBoxHelper.ContentPlacement),Mode=OneWay}"
                         Value="Left">
                <Setter Property="Grid.Column" Value="0" TargetName="Bor"/>
                <Setter Property="Grid.Row" Value="0" TargetName="InnerBor"/>
            </DataTrigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="InnerBor"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="InnerBor"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>