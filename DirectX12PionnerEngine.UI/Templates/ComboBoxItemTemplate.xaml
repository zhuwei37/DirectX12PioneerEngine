<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rs="clr-namespace:DirectX12PioneerEngine.UI.Resources"
                    xmlns:i="clr-namespace:DirectX12PioneerEngine.UI.Helpers">
    <ControlTemplate x:Key="{x:Static rs:TemplateKeys.ComboBoxItemTemplate}" TargetType="ComboBoxItem">
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    x:Name="Bor"
                    Background="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=(i:ElementStateManager.Background),Mode=OneWay}"
                    BorderBrush="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=(i:ElementStateManager.BorderBrush),Mode=OneWay}"
                    BorderThickness="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=(i:ElementStateManager.BorderThickness),Mode=OneWay}"
                    CornerRadius="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=(i:ElementStateManager.BorderBrush)}"
                    TextBlock.Foreground="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=(i:ElementStateManager.Foreground),Mode=OneWay}"
                    TextElement.Foreground="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=(i:ElementStateManager.Foreground),Mode=OneWay}"
                    >
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  />
            </Border>
            <Rectangle Height="2"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" TargetName="Bor" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=(i:ComboBoxItemHelper.SelectedBackground),Mode=OneWay}" />
                <Setter Property="TextBlock.Foreground" TargetName="Bor" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=(i:ComboBoxItemHelper.SelectedForeground),Mode=OneWay}"/>
                <Setter Property="TextElement.Foreground" TargetName="Bor" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=(i:ComboBoxItemHelper.SelectedForeground),Mode=OneWay}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>