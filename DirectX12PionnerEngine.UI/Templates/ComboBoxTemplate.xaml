<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rs="clr-namespace:DirectX12PioneerEngine.UI.Resources"
                    xmlns:i="clr-namespace:DirectX12PioneerEngine.UI.Helpers"
                    >
    <Geometry x:Key="ChevronUp">M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z</Geometry>
    <Geometry x:Key="ChevronDown">M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z</Geometry>

    <ControlTemplate x:Key="{x:Static rs:TemplateKeys.ComboBoxTemplate}" TargetType="ComboBox">
        <Grid>
            <Border x:Name="HeaderBor"
                    Background="{Binding RelativeSource= {RelativeSource TemplatedParent},Path=(i:ElementStateManager.Background),Mode=OneWay}"
                    BorderBrush="{Binding RelativeSource={RelativeSource TemplatedParent},Path=(i:ElementStateManager.BorderBrush),Mode=OneWay}"
                    BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent},Path=(i:ElementStateManager.BorderThickness),Mode=OneWay}"
                    CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent},Path=(i:ElementStateManager.BorderCornerRadius)}"
                    >
                <ToggleButton IsChecked="{Binding RelativeSource={RelativeSource TemplatedParent},Path=IsDropDownOpen,Mode=TwoWay}" >
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <ContentControl x:Name="ContentSite"
                                        IsHitTestVisible="False"
                                       Foreground="{TemplateBinding Foreground}"
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                        ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                         Grid.Column="0"/>
                        <Grid Grid.Column="1" Margin="0,0,2,0">
                            <Path Data="{StaticResource ChevronDown}" Stretch="Uniform"  x:Name="PART_Path" Fill="{TemplateBinding Foreground}" Stroke="{TemplateBinding Foreground}"/>
                        </Grid>

                    </Grid>
                </ToggleButton>
            </Border>
            <Popup x:Name="PART_Popup"  Grid.ColumnSpan="2"
                 
                   MinWidth="{Binding ElementName=HeaderBor,Path=ActualWidth}"  HorizontalAlignment="Stretch" IsOpen="{Binding RelativeSource={RelativeSource TemplatedParent},Path=IsDropDownOpen,Mode=TwoWay}" PlacementTarget="{Binding ElementName=HeaderBor}" Placement="Bottom" >
                <Border x:Name="PART_PopupBor" >
                    <ScrollViewer>
                     <Grid>
                            <Canvas>
                                
                                <Rectangle Width="{Binding ElementName=PART_PopupBor,Path=ActualWidth}" Height="{Binding ElementName=PART_PopupBor,Path=ActualHeight}"
                                    ></Rectangle>
                            </Canvas>
                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="PART_Path" Property="Data" Value="{StaticResource ChevronUp}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>