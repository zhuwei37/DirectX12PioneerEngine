<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F0F7FF"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#1E2A3A"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#4A9EFF"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#6CB2FF"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#3A8AE0"/>

    <SolidColorBrush x:Key="TextBox.BackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBox.BorderBrush" Color="#C9D9E8"/>
    <SolidColorBrush x:Key="TextBox.ForegroundBrush" Color="#1E2A3A"/>
    <SolidColorBrush x:Key="TextBox.Border.FocusedBrush" Color="#4A9EFF"/>
    <SolidColorBrush x:Key="TextBox.Background.MouserOverBrush" Color= "#E1F0FE"/>
    <SolidColorBrush x:Key="TextBox.Border.MouseOverBrush" Color="#6CB2FF"/>

    <SolidColorBrush x:Key="TextBoxWatermark.Foreground" Color="#6F7E8F"/>


    <SolidColorBrush x:Key="CheckBox.BackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CheckBox.BorderBrush" Color="#C9D9E8"/>
    <SolidColorBrush x:Key="CheckBox.ForegroundBrush" Color="#1E2A3A"/>
    <SolidColorBrush x:Key="CheckBox.Background.MouseOverBrush" Color="#E1F0FE"/>
    <SolidColorBrush x:Key="CheckBox.Border.MouseOverBrush" Color="#6CB2FF"/>

    <SolidColorBrush x:Key="CheckBox.Background.CheckedBrush" Color="#4A9EFF"/>
    <SolidColorBrush x:Key="CheckBox.Border.CheckedBrush" Color="#4A9EFF"/>

</ResourceDictionary>